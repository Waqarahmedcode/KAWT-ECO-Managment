# Local setup generates real loopback settings; use npm run db:local.
# Remote values belong in secure hosting/environment settings, never in chat.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Hosted projects can use their browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key remains supported for the local Supabase stack.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
APP_RATE_LIMIT_SALT=
# Local bootstrap/tests only; never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional international payments. PayPal is sandbox unless mode is live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Optional Meta / WhatsApp. Choose a supported API version for your app.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=
META_CONSENT_FIELD=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
APP_RECEIPT_SECRET=
WHATSAPP_RECEIPT_DOCUMENT_TEMPLATE=
WHATSAPP_IMPACT_DOCUMENT_TEMPLATE=
WHATSAPP_RECEIPT_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_RETENTION_TEMPLATE=
WHATSAPP_IMPACT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
APP_UNSUBSCRIBE_SECRET=

# Optional public giving-page analytics, loaded only after explicit consent.
# Avoid duplicate GA4 configuration in GTM if both are used.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# Optional owner-selected first real administrator; private server setting only.
KAWT_FIRST_ADMIN_EMAIL=

# Authorized build-time schema checks/upgrades; private server settings only.
# Separate from runtime DATABASE_URL. Set strict=1 for the connected deployment.
KAWT_READINESS_DATABASE_URL=
KAWT_READINESS_STRICT=1
# For the selected existing development project only; blank skips initialization.
KAWT_INITIALIZE_PROJECT_REF=
