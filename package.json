{
  "name": "kawt-growth-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "KAWT medical camp operations, growth and donor management platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx db/seed.ts",
    "test:data": "python3 tests/audit_data.py",
    "db:local": "node scripts/local-start.mjs",
    "test:unit": "node --import tsx --test tests/contracts.test.ts",
    "test:workflows": "node --env-file=.env.local tests/workflows.mjs",
    "integrations:dry-run": "node --env-file-if-exists=.env.local --import tsx scripts/process-integrations.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "2.119.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.13.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "stripe": "^17.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
